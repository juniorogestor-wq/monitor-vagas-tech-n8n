# ===== Monitor Inteligente de Vagas Tech - variaveis de ambiente =====
# Copie para .env e preencha NO SERVIDOR. NUNCA comite o .env (ver .gitignore).
# Gere segredos fortes: openssl rand -hex 32

# ---- n8n: host / proxy ----
# Subdominio que o LiteSpeed/CyberPanel vai proxyar para 127.0.0.1:5678.
# (definido com o Junior na Etapa 2; ex: n8n.seudominio.com.br)
N8N_HOST=
# Versao da imagem n8n. Pin recomendado para reprodutibilidade (ex: 1.70.0); vazio = latest.
N8N_VERSION=

# ---- n8n: seguranca ----
# Chave de criptografia das credenciais salvas no n8n. FIXAR e nunca perder:
# sem ela, perder o volume n8n_data = perder todas as credenciais. (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=
# Basic auth opcional (o n8n ja exige conta "owner" no 1o acesso). true/false.
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# ---- Postgres ----
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=

# ===== Credenciais das integracoes (configuradas DENTRO do n8n, na Etapa 2) =====
# Referencia aqui; no n8n viram "Credentials" pelo painel (nao ficam no .env em runtime).
# SerpAPI (engine google_jobs)
SERPAPI_KEY=
# Google Gemini (free tier)
GEMINI_API_KEY=
# Telegram Bot (token do @BotFather) + chat de destino
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Google Sheets: service account (JSON) importado no painel do n8n
GOOGLE_SHEETS_SERVICE_ACCOUNT=
